# Получите API-ключ в Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Модели для Vector RAG
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# ID документов в Google Drive / Google Docs / Google Sheets
# (из URL: https://docs.google.com/document/d/<FILE_ID>/edit или https://drive.google.com/file/d/<FILE_ID>/view)
GOOGLE_PRICE_DOC_ID=
GOOGLE_FAQ_DOC_ID=
GOOGLE_SCHEDULE_XLSX_ID=

# Доступ через Google Cloud Service Account (для приватных файлов и отслеживания modifiedTime)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Таблица Google Sheets для записи студентов и поиска свободных окон
GOOGLE_BOOKINGS_SHEET_ID=
